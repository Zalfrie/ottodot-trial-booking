# Copy to .env.local and adjust if you are not using the bundled docker-compose Postgres.
#
# Option A (recommended) - `docker compose up -d` then use these values as-is:
DATABASE_URL=postgresql://ottodot:ottodot_dev@127.0.0.1:5433/ottodot_trial
TEST_DATABASE_URL=postgresql://ottodot:ottodot_dev@127.0.0.1:5433/ottodot_trial_test

# Option B - an existing local Postgres 14+ on the default port. See README "Run without Docker".
# DATABASE_URL=postgresql://ottodot:ottodot_dev@127.0.0.1:5432/ottodot_trial
# TEST_DATABASE_URL=postgresql://ottodot:ottodot_dev@127.0.0.1:5432/ottodot_trial_test

# How long a seat may stay reserved for an in-flight payment before the reaper reclaims it.
SEAT_HOLD_TIMEOUT_SECONDS=300

# How long an untouched pending_payment booking survives before it is expired.
PENDING_BOOKING_TIMEOUT_SECONDS=1800
