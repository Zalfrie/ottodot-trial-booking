{
  "name": "ottodot-trial-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Trial class booking slice for Ottodot - correct seat accounting under concurrency",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:test": "tsx scripts/db-reset.ts --test",
    "db:check": "tsx scripts/check-invariants.ts",
    "jobs:expire-holds": "tsx scripts/expire-stale-holds.ts",
    "demo:race": "tsx scripts/demo-last-seat-race.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.0.8",
    "react-dom": "19.0.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "16.4.7",
    "tsx": "4.23.13",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
